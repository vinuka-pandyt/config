[init]
  defaultBranch = main

[commit]
  gpgSign = true

[user]
	name = Vinuka Kodituwakku
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIo5PIPH1QWNmwxQSA/CmvR6nS1sgU6LVkGE0CR7rpx1
  useConfigOnly = true
	email = vinuka.t@icloud.com

[gpg]
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[includeIf "gitdir:~/Documents/university/"]
  path = ~/.config/gitconfig/gitconfig.uni

[includeIf "gitdir:~/Developer/viduranga/"]
  path = ~/.config/gitconfig/gitconfig.viduranga

[includeIf "gitdir:~/Developer/pandyt/"]
  path = ~/.config/gitconfig/gitconfig.pandyt

[includeIf "gitdir:~/Developer/pola/"]
  path = ~/.config/gitconfig/gitconfig.pola

[includeIf "gitdir:~/Developer/pola/pandyt"]
  path = ~/.config/gitconfig/gitconfig.pola-pandyt

[includeIf "gitdir:~/Developer/polyvoxel/"]
  path = ~/.config/gitconfig/gitconfig.polyvoxel

[includeIf "gitdir:~/Developer/kernel70/self/"]
  path = ~/.config/gitconfig/gitconfig.kernel70

[includeIf "gitdir:~/Developer/kernel70/paffrel/m12m/"]
  path = ~/.config/gitconfig/gitconfig.m12m

[includeIf "gitdir:~/Developer/kernel70/paffrel/self/"]
  path = ~/.config/gitconfig/gitconfig.paffrel

[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
[core]
	pager = diff-so-fancy | less --tabs=4 -RFX
	editor = nvim
[interactive]
	diffFilter = diff-so-fancy --patch
[color]
	ui = true
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[color "diff"]
	meta = 11
	frag = magenta bold
	func = 146 bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
[url "git@github.com-pandyt:Edine-Services/"]
	insteadOf = git@github.com:Edine-Services/
	insteadOf = ssh://git@github.com/Edine-Services/
	insteadOf = https://github.com/Edine-Services/
