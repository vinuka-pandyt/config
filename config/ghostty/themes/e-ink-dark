background = #333333
foreground = #C2C2C2

# Grayscale ramp assigned by role, not by hue name. Slots are ordered here
# dark -> light so the hierarchy is readable; ANSI numbers are what matter.
#
# Claude Code's dark-ansi theme uses slots 1/2 and 9/10 as diff *backgrounds*
# (text is drawn on top of them), so those four stay dark enough to read
# bright text against. Slot 15 is Claude Code's primary body text and is the
# brightest value in the palette; slot 7 is its "subtle/inactive" text and must
# stay clearly below it.

# backgrounds / recessed surfaces
palette = 0=#2B2B2B
palette = 8=#3E3E3E
palette = 2=#474747
palette = 4=#4F4F4F
palette = 1=#5A5A5A
palette = 3=#6B6B6B

# mid: de-emphasized text, borders
palette = 5=#7A7A7A
palette = 7=#8A8A8A
palette = 6=#9A9A9A

# accents, ascending by prominence
palette = 10=#A6A6A6
palette = 9=#B0B0B0
palette = 13=#BABABA
palette = 12=#C4C4C4
palette = 14=#CCCCCC
palette = 11=#D4D4D4

# primary text
palette = 15=#DEDEDE
